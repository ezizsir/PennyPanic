# Copy to .env and fill in. .env is gitignored — never commit real keys.
# If a key was ever committed or shared, treat it as compromised: revoke it on
# Binance (API Management) and Telegram (BotFather /revoke) first.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Only needed if you revive the Telegram prototype (development/PennyPanic_v2.py)
TELEGRAM_BOT_TOKEN=
